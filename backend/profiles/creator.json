  "env": {
    "GUAARDVARK_AGENT_BRAIN": "false",
    "GUAARDVARK_MCP_ENABLED": "false",
    "GUAARDVARK_BROWSER_AUTOMATION": "false",
    "GUAARDVARK_SELF_IMPROVEMENT": "false",
    "GUAARDVARK_INDEX_AUTO_RESUME": "false",
    "GUAARDVARK_ADVANCED_RAG": "false"
  },
  "plugins": {
    "comfyui": true,
    "audio_foundry": true,
    "lora_trainer": true,
    "upscaling": true,
    "video_editor": true,
    "swarm": true
  },
  "startup": {
    "voice_check": false

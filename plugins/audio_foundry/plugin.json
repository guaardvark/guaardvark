{
  "id": "audio_foundry",
  "name": "Audio Foundry",
  "version": "0.2.0",
  "description": "Local audio generation: voiceover with Chatterbox and Kokoro (Kokoro narrates on the CPU when there is no NVIDIA GPU), sound effects, ambience and music beds with Stable Audio Open, and full songs with ACE-Step on an NVIDIA GPU.",
  "author": "Guaardvark",
  "type": "service",
  "category": "generation",
  "port": 8206,
  "vram_estimate_mb": 10000,
  "core": false,
  "dependencies": [],
  "config": {
    "default_enabled": false,
    "default_auto_start": false,
    "service_url": "http://127.0.0.1:8206",
    "timeout": 120,
    "start_timeout": 1800,
    "fallback_enabled": true,
    "default_voice_backend": "chatterbox",
    "default_output_format": "wav",
    "output_dir": "data/outputs/audio"
  },
  "requirements": {
    "gpu": false,
    "cuda": false
  },
  "endpoints": {
    "health": "/health",
    "status": "/status",
    "config": "/config",
    "generate_fx": "/generate/fx",
    "generate_voice": "/generate/voice",
    "generate_music": "/generate/music"
  }
}
+def _token_mask(mask, n_tokens):
+    """An attn_mask on the image's token grid, shaped (B, N, 1), or None.
+
+    FLUX packs each 16x16-pixel patch into one token, so the grid keeps the
+    picture's aspect; the mask arrives at picture size and is resized to it."""
+    if mask is None:
+        return None
+    m = mask if mask.dim() == 3 else mask.unsqueeze(0)
+    h, w = m.shape[-2:]
+    best = None
+    for th in range(1, n_tokens + 1):
+        if n_tokens % th:
+            continue
+        tw = n_tokens // th
+        err = abs(th / tw - h / w)
+        if best is None or err < best[0]:
+            best = (err, th, tw)
+    _, th, tw = best
+    grid = torch.nn.functional.interpolate(m[:, None].float(), size=(th, tw), mode="bilinear", align_corners=False)
+    return grid.reshape(m.shape[0], th * tw, 1)
+

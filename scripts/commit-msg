#!/usr/bin/env bash
#
# Commit-msg hook: refuse a message that names what this repo does not publish.
# The pre-commit gate scans the diff; this is the only place the message itself
# is checked before it travels with a push.
#
# Install: ln -sf ../../scripts/commit-msg "$(git rev-parse --git-common-dir)/hooks/commit-msg"
set -uo pipefail
repo_root="$(git rev-parse --show-toplevel)" || exit 1
exec "$repo_root/scripts/check_portable.sh" --message "$1"

{
  "version": 1,
  "_doc": "Rules for code coming in. Paths are fnmatch globs against the repo-relative path, where * also crosses '/'; '@name' refers to a group. Line rules read added lines only unless \"on\" is \"removed\". Severity maps to a verdict through policy: hold_at and above is held for approval, block_at and above is refused. A rule with \"sources\" applies only to scans from those sources (pr-fork: a pull request from another repository).",

  "policy": {
    "hold_at": "medium",
    "block_at": "critical",
    "sources": {
      "code_editor": {"hold_at": "critical", "_doc": "a person typing in the editor: only a block refuses; findings are still recorded"}
    }
  },

  "caps": {
    "_doc": "max_added_lines bounds memory, not time (hook_seconds and --budget bound time): reading 430,000 added lines of mixed code took 3 s and 250 MB, so a cap far below that only held large changes unread.",
    "max_added_lines": 1000000,
    "hook_seconds": 2.0,
    "findings_per_rule_per_file": 5,
    "blob_min_length": 120,
    "minified_line_length": 1000
  },

  "groups": {
    "python": ["*.py"],
    "javascript": ["*.js", "*.jsx", "*.mjs", "*.cjs", "*.ts", "*.tsx"],
    "shell": ["*.sh", "*.bash", "scripts/pre-commit", "scripts/commit-msg", "scripts/pre-push", "scripts/hooks/*"],
    "code": ["@python", "@javascript", "@shell"],
    "workflows": [".github/workflows/*", ".github/actions/*"],
    "tests": ["tests/*", "*/tests/*", "*/__tests__/*", "*/test_*.py", "*_test.py", "*.test.js", "*.test.jsx", "*.test.ts", "*.test.tsx", "*.spec.js", "*.spec.ts", "*/conftest.py"],
    "docs": ["*.md", "*.rst", "docs/*"],
    "outbound_guard": ["scripts/check_portable.sh", "scripts/pre-commit", "scripts/commit-msg", "scripts/pre-push"],
    "inbound_guard": ["scripts/check_inbound.py", "scripts/inbound_guard/*", "scripts/hooks/*", "scripts/install_hooks.sh", ".github/workflows/inbound-guard.yml", "backend/services/inbound_guard_service.py", "backend/services/inbound_guard_watch.py", "backend/services/inbound_guard_posture.py", "backend/api/inbound_guard_api.py"],
    "security_policy": ["backend/utils/auth_guard.py", "backend/mcp/config.py", "backend/services/mcp_policy.py", "backend/services/tool_execution_guard.py", "backend/services/guarded_code_service.py"],
    "steering": ["CLAUDE.md", "*/CLAUDE.md", "AGENTS.md", "*/AGENTS.md", "AGENT_GUIDE.md", ".agents/*", ".claude/*", "*/SKILL.md", "backend/rule_bundles/*", "backend/lesson_bundles/*", "backend/seed_rules.json", "data/agent/*", "data/config/mcp_servers.json"],
    "python_deps": ["requirements*.txt", "*/requirements*.txt", "constraints*.txt", "*/constraints*.txt"],
    "npm_manifest": ["package.json", "*/package.json"],
    "lockfiles": ["package-lock.json", "*/package-lock.json", "yarn.lock", "*/yarn.lock", "pnpm-lock.yaml", "*/pnpm-lock.yaml"],
    "dependencies": ["@python_deps", "@npm_manifest", "@lockfiles", "pyproject.toml", "*/pyproject.toml", "setup.py", "*/setup.py", "setup.cfg", "*/setup.cfg", "*/custom_nodes.manifest"],
    "pickles": ["*.pkl", "*.pickle", "*.ckpt", "*.pt", "*.pth", "*.bin", "*.joblib"],
    "code_dirs": ["backend/*", "frontend/src/*", "scripts/*", "cli/*", "plugins/*", "extensions/*"],
    "media": ["*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.svg", "*.ico", "*.bmp", "*.woff", "*.woff2", "*.ttf", "*.otf", "*.eot", "*.mp3", "*.wav", "*.ogg", "*.flac", "*.mp4", "*.webm", "*.mov", "*.pdf", "*.safetensors"]
  },

  "path_rules": [
    {"id": "guard.outbound-guard", "pack": "guard-integrity", "severity": "high", "paths": ["@outbound_guard"],
     "why": "changes the check that keeps machine paths, identity and secrets out of commits"},
    {"id": "guard.inbound-guard", "pack": "guard-integrity", "severity": "high", "paths": ["@inbound_guard"],
     "why": "changes the check that reads incoming code; the copy installed in the git directory keeps judging until it is reinstalled"},
    {"id": "guard.guard-deleted", "pack": "guard-integrity", "severity": "critical", "paths": ["@outbound_guard", "@inbound_guard"], "status": ["D"],
     "why": "deletes part of a guard"},
    {"id": "guard.security-policy", "pack": "guard-integrity", "severity": "medium", "paths": ["@security_policy"],
     "why": "changes who may call what, or what self-editing may touch"},
    {"id": "guard.workflow-edited", "pack": "guard-integrity", "severity": "info", "paths": ["@workflows"],
     "why": "CI workflow edited"},
    {"id": "steer.instructions", "pack": "agent-steering", "severity": "medium", "paths": ["@steering"],
     "why": "changes what agents are told or which programs they start; read it as instructions, not as prose"},
    {"id": "steer.outside-contribution", "pack": "agent-steering", "severity": "critical", "paths": ["@steering"], "sources": ["pr-fork"],
     "why": "agent instructions and recipes are written by maintainers only: a recipe sends keys and text to a browser holding the user's sessions before any model reads the request"},
    {"id": "supply.custom-nodes", "pack": "supply-chain", "severity": "medium", "paths": ["*/custom_nodes.manifest"],
     "why": "changes which ComfyUI custom nodes are installed; ComfyUI imports each as Python at start"}
  ],

  "line_rules": [
    {"id": "guard.workflow-trigger", "pack": "guard-integrity", "severity": "high", "paths": ["@workflows"],
     "pattern": "^\\s*(on|permissions)\\s*:|pull_request_target|workflow_run|id-token\\s*:",
     "why": "changes when a workflow runs or what its token may do"},
    {"id": "guard.workflow-secrets", "pack": "guard-integrity", "severity": "high", "paths": ["@workflows"],
     "pattern": "\\$\\{\\{\\s*secrets\\.",
     "why": "hands a repository secret to a workflow step"},
    {"id": "guard.workflow-action", "pack": "guard-integrity", "severity": "medium", "paths": ["@workflows"],
     "pattern": "^\\s*-?\\s*uses\\s*:",
     "why": "adds or re-pins a third-party action, which runs with the job's token"},
    {"id": "guard.workflow-fetch", "pack": "guard-integrity", "severity": "high", "paths": ["@workflows"],
     "pattern": "\\b(curl|wget)\\b",
     "why": "downloads something inside CI"},
    {"id": "guard.step-removed", "pack": "guard-integrity", "severity": "critical", "paths": ["@workflows", "scripts/lint.sh"], "on": "removed",
     "pattern": "check_portable|check_inbound|inbound_guard",
     "why": "removes a guard step"},
    {"id": "guard.allowlist-edited", "pack": "guard-integrity", "severity": "critical", "paths": ["scripts/check_portable.sh"], "on": "both",
     "pattern": "^ALLOW=",
     "why": "changes which paths the portability guard does not read"},

    {"id": "steer.override", "pack": "agent-steering", "severity": "high", "paths": ["@steering"],
     "pattern": "(?i)\\b(ignore|disregard|forget|override)\\b.{0,40}\\b(previous|prior|above|earlier|all|any|other)\\b.{0,20}\\b(instructions?|rules?|guidelines|prompts?|guardrails?)\\b",
     "why": "tells an agent to drop the instructions it was given"},
    {"id": "steer.conceal", "pack": "agent-steering", "severity": "high", "paths": ["@steering"],
     "pattern": "(?i)\\b(do not|don't|never|without)\\b.{0,20}\\b(tell(ing)?|inform(ing)?|mention(ing)?|reveal(ing)?|notify(ing)?|ask(ing)?)\\b.{0,30}\\b(the )?(user|operator|human|owner|maintainer)\\b",
     "why": "tells an agent to keep something from the person it works for"},
    {"id": "steer.exfiltrate", "pack": "agent-steering", "severity": "high", "paths": ["@steering"],
     "pattern": "(?i)\\b(upload|send|post|exfiltrat\\w*|forward|transmit)\\b.{0,60}(https?://|webhook|pastebin|gist\\.github|discord(app)?\\.com/api)",
     "why": "tells an agent to send something off the machine"},
    {"id": "steer.pipe-to-shell", "pack": "agent-steering", "severity": "high", "paths": ["@steering"],
     "pattern": "\\b(curl|wget)\\b[^|\\n]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b|base64\\s+(-d|--decode)",
     "why": "gives an agent a command that runs downloaded or encoded code"},
    {"id": "steer.bypass", "pack": "agent-steering", "severity": "high", "paths": ["@steering"],
     "pattern": "--dangerously-skip-permissions|bypassPermissions|--no-verify|GUAARDVARK_INBOUND_GUARD\\s*=\\s*off",
     "why": "tells an agent to skip a permission prompt or a guard"},

    {"id": "net.hosted-sdk", "pack": "outbound-network", "severity": "high", "paths": ["@python"], "skip": ["@tests"],
     "pattern": "^\\s*(from|import)\\s+(openai|anthropic|mistralai|cohere|groq|together|replicate|google\\.generativeai|google\\.genai|vertexai|boto3|botocore|sentry_sdk|posthog|mixpanel|segment|analytics|ddtrace|datadog|newrelic|bugsnag|rollbar|amplitude|logfire|langsmith|wandb|opentelemetry\\.exporter)\\b",
     "why": "imports a hosted AI or telemetry client; anything sending data off the machine needs the operator's explicit approval"},
    {"id": "net.hosted-sdk-js", "pack": "outbound-network", "severity": "high", "paths": ["@javascript"], "skip": ["@tests"],
     "pattern": "(from\\s+|require\\(\\s*|import\\(\\s*)['\"](openai|@anthropic-ai/[\\w.-]+|@google/generative-ai|@google/genai|@mistralai/[\\w.-]+|cohere-ai|@sentry/[\\w.-]+|posthog-js|posthog-node|mixpanel(-browser)?|@segment/[\\w.-]+|@datadog/[\\w.-]+|@amplitude/[\\w.-]+|@vercel/analytics|logrocket|@bugsnag/[\\w.-]+|rollbar|@opentelemetry/exporter[\\w.-]*)['\"/]",
     "why": "imports a hosted AI or telemetry client; anything sending data off the machine needs the operator's explicit approval"},
    {"id": "net.hosted-sdk-dep", "pack": "outbound-network", "severity": "high", "paths": ["@python_deps", "@npm_manifest", "pyproject.toml", "*/pyproject.toml"],
     "pattern": "(?i)^\\s*\"?(openai|anthropic|mistralai|cohere|groq|together|replicate|google-generativeai|google-genai|vertexai|boto3|sentry-sdk|posthog|mixpanel|ddtrace|newrelic|wandb|langsmith|logfire|@anthropic-ai/sdk|@sentry/[\\w.-]+|posthog-js|@google/generative-ai)\"?\\s*([=<>~!:@\\[;,]|$)",
     "why": "adds a hosted AI or telemetry client as a dependency"},
    {"id": "net.tls-off", "pack": "outbound-network", "severity": "high", "paths": ["@code"], "skip": ["@tests"],
     "pattern": "\\bverify\\s*=\\s*False\\b|rejectUnauthorized\\s*:\\s*false|_create_unverified_context|NODE_TLS_REJECT_UNAUTHORIZED|\\bCERT_NONE\\b|\\bcurl\\b[^\\n]*\\s(-k|--insecure)\\b|\\bwget\\b[^\\n]*--no-check-certificate",
     "why": "turns off TLS certificate checking, so whoever answers is believed"},
    {"id": "net.raw-socket", "pack": "outbound-network", "severity": "medium", "paths": ["@python"], "skip": ["@tests"],
     "pattern": "\\bsocket\\.(socket|create_connection)\\s*\\(",
     "why": "opens a raw network socket"},

    {"id": "exec.shell-true", "pack": "execution", "severity": "high", "paths": ["@python"],
     "pattern": "\\bshell\\s*=\\s*True\\b",
     "why": "runs a command line through the shell, where any interpolated text becomes code"},
    {"id": "exec.os-system", "pack": "execution", "severity": "high", "paths": ["@python"],
     "pattern": "\\bos\\.(system|popen|exec[lv]p?e?|spawn[lv]p?e?)\\s*\\(",
     "why": "runs a command line or replaces the process"},
    {"id": "exec.eval", "pack": "execution", "severity": "high", "paths": ["@python"],
     "pattern": "(?<![\\w.])(eval|exec)\\s*\\(",
     "why": "runs text as Python"},
    {"id": "exec.compile", "pack": "execution", "severity": "low", "paths": ["@python"],
     "pattern": "(?<![\\w.])compile\\s*\\(",
     "why": "compiles text into Python code"},
    {"id": "exec.pickle", "pack": "execution", "severity": "high", "paths": ["@python"],
     "pattern": "\\b(pickle|cPickle|_pickle|dill|cloudpickle|joblib|marshal|shelve)\\.(loads?|open|Unpickler)\\s*\\(",
     "why": "unpickling runs code chosen by whoever wrote the file"},
    {"id": "exec.torch-load", "pack": "execution", "severity": "high", "paths": ["@python"],
     "pattern": "\\btorch\\.load\\s*\\(", "unless": "weights_only\\s*=\\s*True",
     "why": "torch.load without weights_only=True unpickles, which runs code from the file"},
    {"id": "exec.yaml-load", "pack": "execution", "severity": "high", "paths": ["@python"],
     "pattern": "\\byaml\\.(load|load_all|unsafe_load|full_load|unsafe_load_all)\\s*\\(", "unless": "Loader\\s*=\\s*(yaml\\.)?C?SafeLoader",
     "why": "yaml.load without SafeLoader can construct arbitrary objects"},
    {"id": "exec.remote-code", "pack": "execution", "severity": "high", "paths": ["@code"],
     "pattern": "trust_remote_code\\s*=\\s*True|[\"']trust_remote_code[\"']\\s*:\\s*(True|true)",
     "why": "lets a downloaded model repository run its own Python"},
    {"id": "exec.pipe-to-shell", "pack": "execution", "severity": "high", "paths": ["@code", "@workflows", "Dockerfile", "*/Dockerfile"],
     "pattern": "\\b(curl|wget)\\b[^|\\n]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b",
     "why": "runs a downloaded script without keeping a copy to read"},
    {"id": "exec.dynamic-import", "pack": "execution", "severity": "medium", "paths": ["@python"],
     "pattern": "__import__\\s*\\(\\s*[^'\"\\s)]",
     "why": "imports a module whose name is computed at run time"},
    {"id": "exec.native-library", "pack": "execution", "severity": "medium", "paths": ["@python"],
     "pattern": "\\bctypes\\.(CDLL|PyDLL|WinDLL|cdll\\.LoadLibrary)|\\bcdll\\.LoadLibrary",
     "why": "loads a native library into the process"},
    {"id": "exec.js-eval", "pack": "execution", "severity": "high", "paths": ["@javascript"],
     "pattern": "(?<![\\w.$])eval\\s*\\(|\\bnew\\s+Function\\s*\\(",
     "why": "runs text as JavaScript"},
    {"id": "exec.child-process", "pack": "execution", "severity": "high", "paths": ["@javascript"],
     "pattern": "(require\\(\\s*|from\\s+|import\\(\\s*)['\"](node:)?child_process['\"]",
     "why": "starts processes from JavaScript"},
    {"id": "exec.shell-eval", "pack": "execution", "severity": "medium", "paths": ["@shell"],
     "pattern": "(^|[;&|]\\s*)eval\\s+[\"']?\\$",
     "why": "evaluates expanded text as shell code"},

    {"id": "supply.vcs-dependency", "pack": "supply-chain", "severity": "high", "paths": ["@python_deps", "@npm_manifest", "pyproject.toml", "*/pyproject.toml", "setup.py", "*/setup.py", "setup.cfg", "*/setup.cfg"],
     "pattern": "(git|hg|svn|bzr)\\+[a-z]+://|^\\s*-e\\s+\\S|^\\s*[A-Za-z0-9_.-]+(\\[[^\\]]*\\])?\\s*@\\s*(https?|file)://|\"(github|gitlab|bitbucket):|\"git(\\+[a-z]+)?://|\"https?://[^\"]+\\.(tgz|tar\\.gz|zip)\"",
     "why": "installs a dependency from a repository or a URL instead of the package index"},
    {"id": "supply.package-index", "pack": "supply-chain", "severity": "high", "paths": ["@dependencies", "@shell", "@workflows", "pip.conf", ".npmrc", "*/.npmrc"],
     "pattern": "--(extra-)?index-url\\b|--trusted-host\\b|--find-links\\b|^\\s*-[fi]\\s+\\S|^\\s*registry\\s*=|PIP_(EXTRA_)?INDEX_URL",
     "why": "points installs at a different package index"},
    {"id": "supply.custom-node-unpinned", "pack": "supply-chain", "severity": "high", "paths": ["*/custom_nodes.manifest"],
     "pattern": "^[^#|]+\\|[^|]+(\\|\\s*)?$",
     "why": "a custom node with no pinned revision installs whatever its default branch holds that day"},
    {"id": "supply.lockfile-host", "pack": "supply-chain", "severity": "high", "paths": ["@lockfiles"],
     "pattern": "\"resolved\"\\s*:\\s*\"(?!https://registry\\.npmjs\\.org/)|^\\s*resolved\\s+\"(?!https://registry\\.(npmjs\\.org|yarnpkg\\.com)/)",
     "why": "a locked package resolves somewhere other than the npm registry"},
    {"id": "supply.install-script", "pack": "supply-chain", "severity": "high", "paths": ["@npm_manifest"],
     "pattern": "\"(pre|post)?install\"\\s*:",
     "why": "adds a script npm runs on every install"},
    {"id": "supply.prepare-script", "pack": "supply-chain", "severity": "medium", "paths": ["@npm_manifest"],
     "pattern": "\"(prepare|prepublish)\"\\s*:",
     "why": "adds a script npm runs on install from a repository"}
  ],

  "protected_lists": [
    {"paths": ["backend/config.py"], "names": ["PROTECTED_FILES"]},
    {"paths": ["backend/utils/auth_guard.py"], "names": ["PROTECTED_PREFIXES", "TOOL_ENDPOINT_PREFIXES", "TOOL_ENDPOINT_PATHS", "PROTECTED_FILE_PREFIXES", "PROTECTED_DELETE_PREFIXES", "PROTECTED_DELETE_ITEM_PREFIXES", "MUTATION_PROTECTED_PREFIXES", "MUTATION_PROTECTED_SUFFIXES"]},
    {"paths": ["backend/utils/auth_guard.py"], "names": ["SAFE_EXEMPT_PREFIXES"], "weakens_on": "add"},
    {"paths": ["backend/mcp/config.py"], "names": ["DEFAULT_DENY_CATEGORIES"]}
  ],

  "watch": {
    "_doc": "What the source watch reads beyond the files the Interconnector serves: code that runs in-process or steers agents but is not tracked by git.",
    "surfaces": ["plugins/comfyui/ComfyUI/custom_nodes", "extensions", "data/agent/self_knowledge.md", "data/config/mcp_servers.json"],
    "suffixes": [".py", ".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".sh", ".json", ".md", ".txt", ".toml", ".cfg", ".yml", ".yaml"],
    "skip_dirs": [".git", "__pycache__", "node_modules", "venv", ".venv", "dist", "build", "data", "logs", "cache", ".cache"],
    "max_bytes": 2097152,
    "interval_seconds": 600
  },

  "posture": {
    "_doc": "Where the posture checks look for pickle-format model files (loading one can run code).",
    "model_dirs": ["data/models", "plugins/comfyui/ComfyUI/models"],
    "pickle_suffixes": [".ckpt", ".pt", ".pth", ".bin", ".pkl", ".pickle"]
  },

  "network": {
    "_doc": "Hosts a new URL in code may name without a hold. Downloads behind a visible Install, the project's own sites and package registries. Loopback, private ranges and reserved example names are never flagged.",
    "approved_hosts": [
      "github.com", "*.github.com", "raw.githubusercontent.com", "objects.githubusercontent.com", "github.io", "*.github.io",
      "huggingface.co", "*.huggingface.co", "hf.co",
      "pypi.org", "files.pythonhosted.org", "registry.npmjs.org", "nodejs.org", "download.pytorch.org",
      "ollama.com", "*.ollama.com", "guaardvark.com", "*.guaardvark.com",
      "www.w3.org", "schemas.openxmlformats.org", "json-schema.org", "purl.org", "xmlns.com", "ns.adobe.com"
    ],
    "local_hosts": ["localhost", "example.com", "example.org", "example.net"],
    "local_suffixes": [".local", ".lan", ".internal", ".localhost", ".localdomain", ".home", ".home.arpa", ".test", ".example", ".invalid", ".example.com", ".example.org", ".example.net"]
  }
}

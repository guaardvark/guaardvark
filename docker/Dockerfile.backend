FROM python:3.12-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ffmpeg \
    git \
    libpq-dev \
    curl \
    wget \
    rsync \
    lsof \
    procps \
    melt \
    && rm -rf /var/lib/apt/lists/*

# pg_dump/pg_restore for the daily backup and for restores. The client must match the server's major version
# (pgvector/pgvector:pg16 in docker-compose.yml): restores run with --exit-on-error, and a newer client's dump
# opens with settings a 16 server rejects. Debian's own postgresql-client is a newer major, so the client comes
# from the PostgreSQL project's apt repository.
ARG PG_MAJOR=16
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-${PG_MAJOR} \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# PyTorch for the card this image will run on. start-docker.sh --gpu passes
# the channel backend/services/hardware_policy.torch_channel gives for the host
# GPU (cu132 with driver 580+, cu126 for older drivers and Pascal/Volta, cu118
# below driver 525, cu128 for Blackwell below 580). The pins match
# scripts/install_pytorch.sh: 2.14.1 is the newest torch Unsloth accepts, and
# TorchCodec (with the ffmpeg libraries above) gives torchaudio its file I/O.
# Empty installs the PyPI build, which has no kernels below sm_75.
ARG TORCH_CHANNEL=
RUN codec="" && case "$TORCH_CHANNEL" in \
        cu132|cpu|"") pins="torch==2.14.1 torchvision==0.29.1 torchaudio==2.11.1 torchcodec==0.17.0" ;; \
        cu126) pins="torch==2.14.1 torchvision==0.29.1 torchaudio==2.11.0 torchcodec==0.17.0" ;; \
        cu128) pins="torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0 torchcodec==0.11.1" ;; \
        cu118) pins="torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 torchcodec==0.5" ;; \
        rocm6.3) pins="torch torchvision torchaudio"; codec="torchcodec==0.9.1" ;; \
        *) pins="torch torchvision torchaudio" ;; \
    esac \
    && idx="" && if [ -n "$TORCH_CHANNEL" ]; then idx="--index-url https://download.pytorch.org/whl/$TORCH_CHANNEL"; fi \
    && pip install --no-cache-dir $idx $pins \
    && if [ -n "$codec" ]; then pip install --no-cache-dir --no-deps --index-url https://download.pytorch.org/whl/cpu $codec; fi \
    && pip freeze | grep -E '^(torch|torchvision|torchaudio|torchcodec)==' > /tmp/torch-pins.txt

# Install Python dependencies (cached layer). The pins keep the channel build:
# a requirement that needs a newer torch fails the build instead of replacing it.
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -c /tmp/torch-pins.txt -r /app/backend/requirements.txt

# Copy application code
COPY backend/ /app/backend/
COPY scripts/ /app/scripts/
# Plugin sources (Audio Foundry, Video Editor, ...). Per-machine environments, checkouts and
# weights are excluded in .dockerignore; plugins create their environments on first start.
# /app/plugins is a volume in docker-compose.yml, so what plugins build there (the ComfyUI
# app and its models, plugin environments) survives an image update. The image keeps its
# copy here, and docker/entrypoint.sh brings it onto the volume at every start.
COPY plugins/ /app/.plugins-dist/
COPY docker/entrypoint.sh docker/sync_plugins.py /app/docker/
RUN chmod +x /app/docker/entrypoint.sh
# The plugin start scripts and the ComfyUI update service expect /app/backend/venv. The
# packages are installed system-wide in this image, so the venv only has to see them.
RUN python -m venv --system-site-packages /app/backend/venv
# app.py reads the version from here; without it /api/health reports a stale fallback.
COPY VERSION /app/VERSION

# Create data directories
RUN mkdir -p /app/data/uploads /app/data/outputs/narrations /app/data/cache \
    /app/data/context /app/data/database /app/logs /app/pids

# Screen agent (Settings -> Agents): the X desktop the agent drives. Off by default, it adds
# several hundred MB that chat and RAG users do not need.
# Build with --build-arg SCREEN_AGENT=1 to include it.
ARG SCREEN_AGENT=0
RUN if [ "$SCREEN_AGENT" = "1" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            xvfb x11vnc xfce4-session xfwm4 xfce4-panel xfdesktop4 xfce4-settings \
            dbus-x11 xdotool scrot lsof procps firefox-esr \
        && rm -rf /var/lib/apt/lists/*; \
    fi

ENV GUAARDVARK_ROOT=/app
ENV FLASK_APP=backend.app
ENV PYTHONUNBUFFERED=1

EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
    CMD curl -f http://localhost:5000/api/health || exit 1

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["python", "-m", "flask", "run", "--host", "0.0.0.0", "--port", "5000"]

training/models/
unsloth_compiled_cache/
plugins/upscaling/models/*.pth
# Root training snapshot archive — a multi-GB tarball of the whole training/ dir.
# Not source; must never reach a commit. Keep the FILE on disk (it can be the only
# surviving copy of a trained model) but keep it out of git.
training.zip
/*.zip

# Dependency reconciler runtime state (per-machine)
data/dep_reconciler/

# Celery beat schedule state (per-machine, runtime-managed)
data/celerybeat-schedule
data/celerybeat-schedule.db*
# Local passwordless Redis sidecar data dir (start_redis.sh alt-port broker)
data/redis-broker/

# --- Local scratch, backups & per-machine runtime (gitignore audit 2026-05-21) ---
# Backup archives — the bare *.BACK rule misses compound extensions like .BACK.zip
*.BACK.zip
data/*_backup_*.zip
data/*-back.zip
data/data-dir*.zip
# Orchestrator runtime plans (per-machine state, not application source)
data/system/orchestrator_plans.json
# Loose training-knowledge dumps (feedback.jsonl above is the common one; this
# catches the ad-hoc prefixes that accumulate beside it)
data/training/knowledge/*feedback*.jsonl
# Agent desktop runtime home — mime/dbus/gvfs/recently-used caches written per launch
# (sibling of the already-ignored data/agent/xfce_config/)
data/agent/data_home/

# GFPGAN face-restore model weights (large, fetched at runtime)
plugins/upscaling/gfpgan/weights/

# Old training-knowledge snapshots — knowledge/ is tracked, OLD.* backups are not
data/training/knowledge/OLD.*

# Root-level scratch media & frames (generated during video/audio testing)
/*.mp4
/*.wav
/frame_*.jpg

# Scratch YouTube manual run-scripts (ad-hoc run() scripts, not pytest)
backend/tests/test_youtube_chat*.py
backend/tests/test_youtube_final.py

# Runtime editor/session state and locally-trained adapters
data/video_editor_session.json
data/video_editor_state.json
data/training/loras/

# Google Indexing service-account key
data/credentials/

# Swarm internal secret (never publish) + per-film cast reference images (runtime, machine-local)
data/.swarm_internal_secret
data/cast_refs/

# Per-clone check_portable.sh lists — the names and patterns they hold must stay
# out of the public file that enforces them. See CONTRIBUTING.md.
scripts/.portable-local-patterns
scripts/.portable-local-paths

# Per-machine build/runtime state, regenerated by start.sh / verify_gpu_stack.sh
frontend/.npm_stamp
data/gpu_stack_status.json
data/ollama-dropin.rendered.conf

# === Non-code artifacts — NEVER in git (operator standing rule, 2026-06-24) ===
# Policy: main tracks STANDARD APPLICATION CODE ONLY. No model weights, no
# training data/outputs, no personal transcripts, no runtime state. The operator
# keeps local backups for these — git is for source, not for gigabytes.
#
# Model weights & checkpoints (anywhere in the tree)
*.safetensors
*.ckpt
*.gguf
*.pt
*.pth
*.bin
*.onnx
# External trainer repos cloned into the lora_trainer plugin (multi-GB, third-party)
plugins/lora_trainer/SimpleTuner/
plugins/lora_trainer/ai-toolkit/
plugins/lora_trainer/musubi-tuner/
plugins/lora_trainer/sd-scripts-flux/
# Logs, debug dumps, LLM/agent transcripts (personal / regenerable)
*.log
debug.log
# Cursor IDE local rules/state (operator machine only — not product code)
.cursor/
# Per-machine runtime state written by the app
data/video_model_download_status.json
storage/

# In-tree whisper.cpp checkout (own nested .git, 800MB+ build) — never track
backend/tools/voice/whisper.cpp/
# App-mutated plugin state (same class as data/ runtime state, see b2cc46a)
plugins/comfyui/.custom_nodes_installed
data/embedding_meta.json
data/documents_windows_v2_state.json
data/sticky_notes_state.json
# Pre-migration copies of the file-backed index, kept on disk after the pgvector move
data/_pre_pgvector_backup/
# Per-install plugin manifest overrides (merged over plugin.json at load)
plugins/*/plugin.local.json

# Code-editor and dashboard layout — per-install UI state, not source.
data/code_editor_state.json
data/code_editor_session.json
data/dashboard_state.json

# Episode render output — regenerable from the pipeline; fixtures beside it are tracked.
data/demo_assets/*/render/

# Episode production notes are working documents, not shipped docs.
data/demo_assets/*/README.md

# Claude Code workspace config. Every file here so far — permission allowlists,
# hooks, workflows — points at this machine or at docs/local-workspace-only/,
# which is itself ignored, so the whole directory stays local. To ship a hook or
# skill deliberately, un-ignore that one path; never the directory.
.claude/

# Build-time copy of the repo-root VERSION, so an sdist can carry it. Generated
# by the release workflow; the root VERSION file stays the source of truth.
cli/VERSION

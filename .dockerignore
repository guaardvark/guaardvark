# Git
.git
.gitignore

# Python
backend/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node
frontend/node_modules/
frontend/dist/

# Data (mounted as volumes)
data/
logs/
pids/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Build artifacts
libs/guaardvark-guardian/dist/
libs/guaardvark-guardian/build/

# Sensitive
.env
*.key
*.pem

# Large models (pulled at runtime)
backend/tools/voice/whisper.cpp/models/
backend/tools/voice/piper-models/*.onnx

# Docs & specs (not needed in container)
docs/superpowers/specs/
docs/prompts/

# Training data
training/
unsloth_compiled_cache/

# Plugins: sources go into the image, per-machine environments, third-party checkouts,
# model weights and runtime output do not
plugins/*/venv*/
plugins/*/.venv*/
plugins/comfyui/ComfyUI*/
plugins/comfyui/.update_job.json
plugins/comfyui/.custom_nodes_installed
plugins/lora_trainer/SimpleTuner/
plugins/lora_trainer/ai-toolkit/
plugins/lora_trainer/musubi-tuner/
plugins/lora_trainer/sd-scripts-flux/
plugins/upscaling/models/*.pth
plugins/upscaling/gfpgan/weights/
plugins/*/outputs/
plugins/*/output/
plugins/*/cache/
plugins/*/tmp/
plugins/*/.cache/
plugins/*/__pycache__/
plugins/*/plugin.local.json

# Git
.git
.gitignore

# Python
backend/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node
frontend/node_modules/
frontend/dist/
frontend/dist.next/
frontend/dist.old/

# Data (mounted as volumes). The tracked defaults below go into the image as
# /app/.data-dist and docker/seed_data.py copies them onto the data volume. One
# line per tracked file, so nothing a machine wrote under data/ can enter an image
# built from a used checkout (backend/tests/test_docker_seed_data.py checks the list).
data/**
!data/agent/LEARNING_PRINCIPLES.md
!data/agent/configs/agent.tint2rc
!data/agent/example_traces.json
!data/agent/files/agent-drawing.png
!data/agent/files/agent_course.html
!data/agent/files/calibration.png
!data/agent/files/calibration_blind.png
!data/agent/files/calibration_blind_1024.png
!data/agent/files/calibration_blind_1024sq.png
!data/agent/files/comments_trainer.html
!data/agent/files/paint_trainer.html
!data/agent/files/vision_trainer.html
!data/agent/files/vision_trainer_grid.html
!data/agent/files/watch_page_trainer.html
!data/agent/recipes.json
!data/agent/self_knowledge.md
!data/agent/self_knowledge_compact.md
!data/agent/style_recipes/README.md
!data/agent/style_recipes/cinematic.json
!data/agent/style_recipes/dark.json
!data/agent/style_recipes/default.json
!data/agent/style_recipes/grunge.json
!data/agent/style_recipes/music-video.json
!data/agent/wallpapers/default.jpg
!data/config/mcp_servers.json.example
!data/conversations/README.md
!data/logos/README.md
!data/quality/baseline.json
!data/rag_research_program.md
!data/system/README.md
logs/
pids/

# CLI: the package goes into the image, its tests and build output do not.
cli/tests/
cli/build/
cli/dist/

# Extensions are client code and never enter an image; docker-compose.yml mounts
# the extensions/ folder instead. Only the scaffold comes in.
extensions/**
!extensions/README.md
!extensions/__init__.py

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Build artifacts
libs/guaardvark-guardian/dist/
libs/guaardvark-guardian/build/

# Sensitive
.env
*.key
*.pem

# Large models (pulled at runtime)
backend/tools/voice/whisper.cpp/models/
backend/tools/voice/piper-models/*.onnx

# Docs & specs (not needed in container)
docs/superpowers/specs/
docs/prompts/

# Training data
training/
unsloth_compiled_cache/

# Plugins: sources go into the image, per-machine environments, third-party checkouts,
# model weights and runtime output do not
plugins/*/venv*/
plugins/*/.venv*/
plugins/comfyui/ComfyUI*/
plugins/comfyui/.update_job.json
plugins/comfyui/.custom_nodes_installed
plugins/lora_trainer/SimpleTuner/
plugins/lora_trainer/ai-toolkit/
plugins/lora_trainer/musubi-tuner/
plugins/lora_trainer/sd-scripts-flux/
plugins/upscaling/models/*.pth
plugins/upscaling/gfpgan/weights/
plugins/*/outputs/
plugins/*/output/
plugins/*/cache/
plugins/*/tmp/
plugins/*/.cache/
plugins/*/__pycache__/
plugins/*/plugin.local.json
